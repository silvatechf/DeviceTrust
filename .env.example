# Copy this file to .env and replace all values with local-only configuration.
# Generate independent random secrets; never reuse production credentials.
DEVICETRUST_AUTH_MODE=legacy
DEVICETRUST_API_KEY=replace-with-random-64-character-hex
POSTGRES_PASSWORD=replace-with-random-64-character-hex
DATABASE_URL=postgresql+psycopg://devicetrust:replace-with-random-64-character-hex@db:5432/devicetrust
